{
    "max_file_lines": 300,

    "max_function_lines": 50,

    "supported_extensions": [
        ".py",
        ".ts",
        ".js"
    ],

    "ignored_directories": [
        "venv",
        ".git",
        "__pycache__",
        ".pytest_cache"
    ],

    "forbidden_dependencies": [
        [
            "controllers",
            "repositories"
        ]
    ],

    "enable_circular_dependency_check": true,

    "architecture_score": {
        "file_penalty": 10,
        "function_penalty": 5,
        "architecture_penalty": 20,
        "circular_dependency_penalty": 30
    }
}